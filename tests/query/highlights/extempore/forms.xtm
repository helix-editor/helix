;                  ^ @comment.block.documentation
;                                          ^ @variable.parameter
;                                            ^ @type

(bind-type Point <double,double>)
;^ @keyword
;          ^ @type
;                 ^ @type

(bind-alias VoiceFn [void,Voice*,SAMPLE*]*)
